		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_GravshipUraniumSlugTurret" or defName="VGE_EnemyGravshipUraniumSlugTurret"]/building/turretBurstCooldownTime</xpath>
