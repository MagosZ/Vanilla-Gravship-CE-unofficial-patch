		</value>
	</Operation>

	<!-- uranium slug turrets -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_GravshipUraniumSlugTurret" or defName="VGE_EnemyGravshipUraniumSlugTurret"]/statBases/*[self::MaxHitPoints or self::Flammability or self::WorkToBuild or self::ShootingAccuracyTurret or self::AimingAccuracy or self::NightVisionEfficiency]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/ThingDef[defName="VGE_GravshipUraniumSlugTurret" or defName="VGE_EnemyGravshipUraniumSlugTurret"]/statBases/*[self::MaxHitPoints or self::Flammability or self::WorkToBuild or self::ShootingAccuracyTurret or self::AimingAccuracy or self::NightVisionEfficiency]</xpath>
