<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- VGE Chapter 2 compact gravship turrets (player and enemy) become CE turrets (DESIGN.md section 3).
	     Loaded only when Chapter 2 is active (loadFolders.xml). Rule: each value = CE's value for the matching
	     turret x (VGE value / vanilla value). Pairings: autocannon and uranium slug with the vanilla/CE turrets
	     of the same name; the minigun's building with the mini-turret, its gun with the hand-held minigun. -->

	<!-- ========== Both abstract parents ========== -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="VGE_GravshipCompactTurretBase" or @Name="VGE_EnemyGravshipCompactTurretBase"]/thingClass</xpath>
		<value>
			<thingClass>CombatExtended.Building_TurretGunCE</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="VGE_GravshipCompactTurretBase" or @Name="VGE_EnemyGravshipCompactTurretBase"]/fillPercent</xpath>
		<value>
			<fillPercent>0.85</fillPercent>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[@Name="VGE_GravshipCompactTurretBase" or @Name="VGE_EnemyGravshipCompactTurretBase"]/comps/li[@Class="CompProperties_Stunnable"]/affectedDamageDefs/li[.="Stun"]</xpath>
	</Operation>

	<!-- ========== Buildings ========== -->

	<!-- CE removes the explode-when-destroyed comp from its turrets -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret" or defName="VGE_EnemyGravshipMinigunTurret" or defName="VGE_GravshipAutocannonTurret" or defName="VGE_EnemyGravshipAutocannonTurret" or defName="VGE_GravshipUraniumSlugTurret" or defName="VGE_EnemyGravshipUraniumSlugTurret"]/comps/li[@Class="CompProperties_Explosive"]</xpath>
	</Operation>

	<!-- Player turrets: CE ammo replaces VGE's steel/uranium refuelling -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret" or defName="VGE_GravshipAutocannonTurret" or defName="VGE_GravshipUraniumSlugTurret"]/comps/li[@Class="CompProperties_Refuelable"]</xpath>
	</Operation>

	<!-- Every building gets its own statBases node; its values override the parent's -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret"]/statBases</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret"]</xpath>
			<value>
				<statBases />
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_EnemyGravshipMinigunTurret"]/statBases</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VGE_EnemyGravshipMinigunTurret"]</xpath>
			<value>
				<statBases />
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_GravshipAutocannonTurret"]/statBases</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VGE_GravshipAutocannonTurret"]</xpath>
			<value>
				<statBases />
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_EnemyGravshipAutocannonTurret"]/statBases</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VGE_EnemyGravshipAutocannonTurret"]</xpath>
			<value>
				<statBases />
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_GravshipUraniumSlugTurret"]/statBases</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VGE_GravshipUraniumSlugTurret"]</xpath>
			<value>
				<statBases />
			</value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_EnemyGravshipUraniumSlugTurret"]/statBases</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="VGE_EnemyGravshipUraniumSlugTurret"]</xpath>
			<value>
				<statBases />
			</value>
		</nomatch>
	</Operation>

	<!-- minigun turrets -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret" or defName="VGE_EnemyGravshipMinigunTurret"]/statBases/*[self::WorkToBuild or self::ShootingAccuracyTurret or self::AimingAccuracy]</xpath>
		<match Class="PatchOperationRemove">
			<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret" or defName="VGE_EnemyGravshipMinigunTurret"]/statBases/*[self::WorkToBuild or self::ShootingAccuracyTurret or self::AimingAccuracy]</xpath>
		</match>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret" or defName="VGE_EnemyGravshipMinigunTurret"]/statBases</xpath>
		<value>
			<WorkToBuild>50000</WorkToBuild>
			<ShootingAccuracyTurret>0.5</ShootingAccuracyTurret>
			<AimingAccuracy>0.25</AimingAccuracy>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret" or defName="VGE_EnemyGravshipMinigunTurret"]/costList</xpath>
		<value>
			<costList>
				<Steel>175</Steel>
				<GravlitePanel>40</GravlitePanel>
				<ComponentIndustrial>5</ComponentIndustrial>
			</costList>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret" or defName="VGE_EnemyGravshipMinigunTurret"]/building/turretBurstCooldownTime</xpath>
		<value>
			<turretBurstCooldownTime>1.25</turretBurstCooldownTime>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="VGE_GravshipMinigunTurret"]/comps/li[@Class="CompProperties_Power"]/basePowerConsumption</xpath>
		<value>
			<basePowerConsumption>200</basePowerConsumption>
		</value>
	</Operation>

	<!-- autocannon turrets -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="VGE_GravshipAutocannonTurret" or defName="VGE_EnemyGravshipAutocannonTurret"]/statBases/*[self::MaxHitPoints or self::Flammability or self::WorkToBuild or self::ShootingAccuracyTurret or self::AimingAccuracy]</xpath>
