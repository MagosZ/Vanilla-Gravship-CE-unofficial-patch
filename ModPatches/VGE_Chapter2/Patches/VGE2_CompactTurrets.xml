			<xpath>Defs/ThingDef[defName="VGE_GravshipAutocannonTurret" or defName="VGE_EnemyGravshipAutocannonTurret"]/statBases/*[self::MaxHitPoints or self::Flammability or self::WorkToBuild or self::ShootingAccuracyTurret or self::AimingAccuracy]</xpath>
		</match>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="VGE_GravshipAutocannonTurret" or defName="VGE_EnemyGravshipAutocannonTurret"]/statBases</xpath>
		<value>
			<MaxHitPoints>375</MaxHitPoints>
			<Flammability>0.4</Flammability>
			<WorkToBuild>35000</WorkToBuild>
			<ShootingAccuracyTurret>1.25</ShootingAccuracyTurret>
			<AimingAccuracy>0.75</AimingAccuracy>
